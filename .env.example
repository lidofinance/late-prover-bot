# Required
CHAIN_ID=1
EL_RPC_URLS=https://mainnet.infura.io/v3/...
CL_API_URLS=https://quiknode.pro/...
LIDO_LOCATOR_ADDRESS=0xC1d0b3DE6792Bf6b4b37EccdcC24e45978Cfd2Eb

# Required unless DRY_RUN=true
TX_SIGNER_PRIVATE_KEY=deadbeef...

# The three secrets above can come from files instead of the env: set the path, one secret per file.
# The file wins over the variable. See "Secrets from files" in the README.
# TX_SIGNER_PRIVATE_KEY_FILE=/vault/secrets/tx-signer-private-key
# EL_RPC_URLS_FILE=/vault/secrets/el-rpc-urls
# CL_API_URLS_FILE=/vault/secrets/cl-api-urls

# Optional, see the README for the full list and the defaults
# DRY_RUN=false
# LOG_FORMAT=json
# START_LOOKBACK_DAYS=7
